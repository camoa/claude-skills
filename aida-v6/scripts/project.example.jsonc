// project.example.jsonc: a worked example of <path>/project.json.
//
// This file is documentation, read by a person, never by a script. A real project.json is plain
// JSON with no comments, validated against project-schema.json in this same folder. Delete every
// comment below and what remains is a valid project.json on its own; that is proved by running it
// through the schema after stripping.
//
// This example shows a project a little past creation, with fields a later stage has since filled
// in (processRecipes, sources, playbookSubscriptions) so their real shape is visible. A brand-new
// project has processRecipes and sources as empty arrays, and playbookSubscriptions as an empty
// object, until something needs them.
{
  // The shape this file was written in. A repair reads format-changes.md by this number instead
  // of guessing what an old file's shape was.
  "schemaVersion": 1,

  // Where the code lives. Always set, never "docs-only" or "unknown": a greenfield project names
  // the path even before anything exists there. One of the two facts creation asks for directly.
  "codePath": "/home/camoa/workspace/example-project",

  // The project's name. Asked directly at creation, never derived from the code folder's own
  // name, because deriving it saves one question and buys a collision problem. Also the value the
  // registry copies, so a project can be found by name without opening this file.
  "name": "example_project",

  // The stack. Detected from the code at creation (a composer file, a package file, a go module,
  // a Python project file, a Drupal info file) and asked only when detection finds nothing.
  "frameworks": ["drupal"],

  // Which source answered, for each stage, the process-recipe question. Empty at creation; the
  // recipe-adoption sweep fills one entry in the first time a stage needs a cell it does not have.
  // "fit" is free text set by the stage that adopted the recipe, not a fixed vocabulary.
  "processRecipes": [
    { "key": "research/drupal/prior-art", "source": "hosted-catalog", "fit": "fits" }
  ],

  // Where guides, playbooks, process recipes and agentic recipes come from. A project declares as
  // many sources as it wants, and mixing is the point: here the hosted catalog answers for guides
  // and agentic recipes everywhere, while a team's own folder answers for playbooks and process
  // recipes, but only for Drupal research and design. Each source's precedence is per kind, since
  // a source's playbooks winning says nothing about whether its process recipes should too.
  "sources": [
    {
      "location": "hosted-catalog",
      "locationType": "catalog",
      "provides": ["guides", "agenticRecipes"],
      "answersFor": { "extent": "everything" },
      "precedence": { "guides": 2, "agenticRecipes": 1 }
    },
    {
      "location": "/home/camoa/workspace/team-playbooks/drupal",
      "locationType": "folder",
      "provides": ["playbooks", "processRecipes"],
      "answersFor": { "extent": "stages", "stages": ["research", "design"] },
      "precedence": { "playbooks": 1, "processRecipes": 1 }
    },
    {
      "location": "hosted-catalog",
      "locationType": "catalog",
      "provides": ["playbooks", "processRecipes"],
      "answersFor": { "extent": "everything" },
      "precedence": { "playbooks": 2, "processRecipes": 2 }
    }
  ],

  // Which playbooks apply, recorded per framework, and never inferred from a source. A source
  // says where playbooks can be found; this says which ones this project actually subscribes to
  // for the "drupal" framework. Empty until a person decides, which can be any time.
  "playbookSubscriptions": {
    "drupal": ["drupal/best-practices/community"]
  },

  // Whether a task builds in a worktree without being asked first. Set at creation; false unless
  // a project says otherwise.
  "worktreeByDefault": false,

  // The project's lifecycle state: active, complete, or archived. Set to "active" at creation and
  // changed only by a later, explicit transition, each one reversible.
  "state": "active",

  // Whether visual regression is set up, and the path to its surface registry. Null until a
  // visual-regression setup skill (a later part) runs. Baseline images live in the code
  // repository, beside the tests that read them; this field points at the registry, never at
  // pixel data.
  "visualRegression": null,

  // Whether end-to-end testing is set up. Null until an e2e setup skill (a later part) runs. The
  // shape past "enabled" is intentionally open for that skill to extend.
  "e2e": null,

  // Whether the memory hook is installed, and which version, so a stale installed copy is a
  // comparison, not a guess. Not installed by default.
  "memoryHook": { "installed": false, "version": null },

  // Stops work starting in this repository without a task. Null until the offer is made; once
  // made, the offer and the answer are recorded together, so a decline is never re-asked.
  "taskRule": null
}
