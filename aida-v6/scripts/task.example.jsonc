// task.example.jsonc: a worked example of <task folder>/task.json.
//
// This file is documentation, read by a person, never by a script. A real task.json is plain
// JSON with no comments, validated against task-schema.json in this same folder. Delete every
// comment below and what remains is a valid task.json on its own; that is proved by running it
// through the schema after stripping.
//
// This example shows a task one level under a split parent, with a mechanism hint and an
// external tracker id filled in so their real shape is visible. A brand-new task has
// mechanismHints and externalIds empty, parent null unless it was split off from something, and
// children empty until it is split itself.
{
  // The shape this file was written in. A repair reads format-changes.md by this number instead
  // of guessing what an old file's shape was.
  "schemaVersion": 1,

  // This task's own identifier, defaulting from its folder name at creation. No path separator,
  // never "." or "..".
  "id": "add-refresh-token-rotation",

  // The task's own lifecycle state, written by whoever changes it. Becomes "in_progress" the
  // first time any stage writes an artifact, usually scope but not because scope is special.
  "state": "in_progress",

  // The id of the task one level up, when this task is a child. Null for a task with no parent.
  "parent": "rework-session-auth",

  // The ids of this task's own children, in no particular order. Empty for a task with none.
  // This is what replaces version 5's four-valued "kind" field: a task has children or it does
  // not, and whether it sits one level down or two is a question about "parent", not this field.
  "children": ["rotate-refresh-token-storage"],

  // Present only when a person has asked for an autonomous run on this task; absent otherwise,
  // which means interactive, the safe default. There is no "interactive" value to write.
  // "runMode": "autonomous",

  // Optional hints naming an implementation approach a stage should read before choosing one of
  // its own. Empty on most tasks; this one carries a required hint from the parent it was split
  // from.
  "mechanismHints": [
    { "approach": "reuse the existing TokenStore service rather than a new table", "status": "required" }
  ],

  // This task's id in an external tracker, one entry per system it is known to. Reserved for
  // tracker integration; most tasks never set one.
  "externalIds": { "jira": "PROJ-4231" }
}
